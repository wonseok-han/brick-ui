{
  "name": "@brick/icons",
  "version": "0.0.0",
  "description": "brick-ui 아이콘 — currentColor 기반 React SVG 컴포넌트",
  "license": "MIT",
  "author": "wonseok-han",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonseok-han/brick-ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/wonseok-han/brick-ui#readme",
  "bugs": "https://github.com/wonseok-han/brick-ui/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@brick/typescript-config": "workspace:*",
    "@brick/vite-config": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
